{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @ai-job-applier/shared && npm run build -w @ai-job-applier/dashboard && rm -rf dist && cp -r apps/dashboard/dist dist",
  "outputDirectory": "dist",
  "framework": null,
  "env": {
    "VITE_API_URL": "/api"
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "outputFileTracingIncludes": {
    "/api/index.ts": [
      "./node_modules/pg/**",
      "./node_modules/pg-hstore/**",
      "./node_modules/bcrypt/**",
      "./node_modules/sequelize/**",
      "./node_modules/sequelize-typescript/**"
    ]
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "apps/api/src/**,packages/shared/dist/**,node_modules/pg/**,node_modules/pg-hstore/**,node_modules/bcrypt/**"
    }
  }
}
