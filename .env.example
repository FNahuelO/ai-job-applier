NODE_ENV=production

# PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgres://user:password@host:5432/ai_job_applier

# API
API_PORT=3000
API_PREFIX=api
JWT_SECRET=nGEU6KtzFYcGEDk1s1x96HSAOdzlmWfnB07Q85CCeMS
JWT_EXPIRES_IN=7d

# Dashboard (Vite — embebido en el build de Vercel)
# En Vercel usa /api para llamar a la API en el mismo dominio.
VITE_API_URL=/api

# Worker (no se despliega en Vercel; usar Docker, Railway, Render, etc.)
WORKER_LOG_LEVEL=info
# JOB_SEARCH_TITLE ya no se usa: configurarlo desde Jobs en el dashboard (/jobs)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_SESSION_PATH=./storage/state/linkedin-session.json
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=150
PLAYWRIGHT_TIMEOUT_MS=45000
PLAYWRIGHT_ERROR_SCREENSHOT_DIR=./storage/screenshots
API_BASE_URL=https://tu-proyecto.vercel.app/api

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
